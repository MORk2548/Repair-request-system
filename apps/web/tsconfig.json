{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "preserve",
    "allowJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "incremental": true,
    "noUncheckedSideEffectImports": false,
    "types": [
      "node",
      "next"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-e2e/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-nav/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
