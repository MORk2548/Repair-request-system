# Copy to .env. A phone cannot reach this PC's localhost: use the PC's Wi-Fi address (ipconfig), not 127.0.0.1.
# Anon key: corepack pnpm exec supabase status -o env (ANON_KEY).
EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.67:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Push needs an EAS project id from an Expo account: npx eas init (in apps/mobile) writes it to app.json extra.eas.projectId,
# or put it here. With neither, the app skips push registration.
EXPO_PUBLIC_EAS_PROJECT_ID=
