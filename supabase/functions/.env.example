# Read by the Edge Functions; copy to supabase/functions/.env to override the default.
WEB_BASE_URL=http://localhost:3000

# Must equal the Vault secret notify_webhook_secret (supabase/seed.sql sets this value locally).
NOTIFY_WEBHOOK_SECRET=local-dev-notify-secret

# Uncomment to send pushes to a local listener instead of Expo, to see them without a phone.
# EXPO_PUSH_URL=http://host.docker.internal:8787/push
