{
  "name": "repair-request-system",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "corepack pnpm -r test",
    "typecheck": "corepack pnpm -r typecheck",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db && corepack pnpm --filter @repair/core test:db"
  },
  "devDependencies": {
    "supabase": "3.1.0"
  }
}
